# Config pour docker-compose UNIQUEMENT (usage local) — copier ce fichier en
# ".env" à la racine (déjà ignoré par git, voir .gitignore) avant de lancer
# `docker compose up`. Aucun lien avec les variables configurées sur
# Render/Vercel : ceci ne touche jamais le déploiement en ligne.

# ── Base de données (service "db") ────────────────────────────────────────────
DB_NAME=tirahoudb
DB_USER=tirahou
DB_PASSWORD=changeme_local_only

# ── Backend Django (service "backend") ────────────────────────────────────────
# Clé arbitraire suffisante en local — ne jamais réutiliser une clé de prod ici.
SECRET_KEY=docker-dev-secret-key-change-if-you-want
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Optionnel — laisser vide désactive juste la fonctionnalité correspondante
# (le chatbot répond "non configuré" au lieu de planter).
ANTHROPIC_API_KEY=

# ── Frontend Vite (service "frontend") ────────────────────────────────────────
# http://localhost:8001, pas http://backend:8000 : ce sont les URLs vues par
# le NAVIGATEUR (hors réseau interne Docker), pas par le conteneur lui-même.
VITE_API_URL=http://localhost:8001/api/v1
